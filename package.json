{
  "name": "thumbsup",
  "version": "0.1.0",
  "private": true,
  "description": "Hand-gesture reactions for any browser video call — the macOS Reactions feature, for Chrome.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/fetch-mediapipe-assets.mjs && node scripts/gen-icons.mjs",
    "build": "npm run assets && node scripts/build.mjs",
    "dev": "npm run assets && node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.mts,.mjs",
    "clean": "rm -rf dist public/models public/wasm public/icons"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
